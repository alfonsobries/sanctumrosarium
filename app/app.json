{
  "expo": {
    "name": "SanctaMaria",
    "slug": "sanctamaria",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "sanctamaria",
    "icon": "./assets/icons/ios-light.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0F1420",
    "ios": {
      "bundleIdentifier": "app.sanctamaria",
      "supportsTablet": false,
      "icon": {
        "light": "./assets/icons/ios-light.png",
        "dark": "./assets/icons/ios-dark.png",
        "tinted": "./assets/icons/ios-tinted.png"
      },
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "UIBackgroundModes": ["audio"]
      }
    },
    "android": {
      "package": "app.sanctamaria",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/android-foreground.png",
        "backgroundImage": "./assets/icons/android-background.png",
        "monochromeImage": "./assets/icons/android-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "output": "static",
      "favicon": "./assets/icons/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ECEEF1",
          "image": "./assets/icons/splash-icon-light.png",
          "imageWidth": 160,
          "dark": {
            "backgroundColor": "#0F1420",
            "image": "./assets/icons/splash-icon-dark.png"
          }
        }
      ],
      "expo-font",
      "expo-audio",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
