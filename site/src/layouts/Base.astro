---
import '../styles/global.css';

import Logo from '../components/Logo.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { t, type UiLanguage } from '../i18n/ui';
import { pathFor, type PathName } from '../i18n/paths';

type Props = {
  language: UiLanguage;
  title?: string;
  description?: string;
  current?: PathName;
};

const { language, title, description, current = 'home' } = Astro.props;
const translate = t(language);
const otherHome = language === 'es' ? 'en' : 'es';
const other = pathFor(otherHome, current);
const nav: {
  name: PathName;
  key: 'nav.app' | 'nav.features' | 'nav.how' | 'nav.mysteries' | 'nav.about';
}[] = [
  { name: 'home', key: 'nav.app' },
  { name: 'features', key: 'nav.features' },
  { name: 'how', key: 'nav.how' },
  { name: 'mysteries', key: 'nav.mysteries' },
  { name: 'about', key: 'nav.about' },
];
---

<!doctype html>
<html lang={language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>
      {title ? `${title} - ${translate('site.title')}` : translate('site.title')}
    </title>
    <meta name="description" content={description ?? translate('site.description')} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.bunny.net" />
    <link
      href="https://fonts.bunny.net/css?family=literata:400,400i,600,700"
      rel="stylesheet"
    />
    <link
      rel="alternate"
      hreflang="es"
      href={new URL(pathFor('es', current), Astro.site ?? Astro.url).href}
    />
    <link
      rel="alternate"
      hreflang="en"
      href={new URL(pathFor('en', current), Astro.site ?? Astro.url).href}
    />
    <script is:inline>
      (function () {
        var key = 'sanctamaria-theme';
        var stored = localStorage.getItem(key);
        var theme =
          stored === 'light' || stored === 'dark'
            ? stored
            : window.matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light';
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#contenido">{translate('skip')}</a>
    <header class="site-header">
      <div class="wrap bar">
        <a class="brand" href={pathFor(language, 'home')}>
          <Logo class="brand-mark" title={translate('site.title')} />
          <span class="brand-name">{translate('site.title')}</span>
        </a>
        <nav class="nav-links" aria-label="principal">
          {
            nav.map((item) => (
              <a
                href={pathFor(language, item.name)}
                aria-current={current === item.name ? 'page' : undefined}
              >
                {translate(item.key)}
              </a>
            ))
          }
        </nav>
        <details class="nav-menu">
          <summary>{translate('nav.menu')}</summary>
          <nav>
            {
              nav.map((item) => (
                <a
                  href={pathFor(language, item.name)}
                  aria-current={current === item.name ? 'page' : undefined}
                >
                  {translate(item.key)}
                </a>
              ))
            }
          </nav>
        </details>
        <div class="header-tools">
          <ThemeToggle language={language} />
          <a class="lang-switch" href={other} hreflang={language === 'es' ? 'en' : 'es'}>
            {language === 'es' ? 'English' : 'Español'}
          </a>
        </div>
      </div>
    </header>

    <main id="contenido">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <div class="cols">
          <p>{translate('footer.mark')}</p>
          <nav>
            <a href={pathFor(language, 'features')}>{translate('nav.features')}</a>
            <a href={pathFor(language, 'how')}>{translate('nav.how')}</a>
            <a href={pathFor(language, 'about')}>{translate('nav.about')}</a>
            <a href={pathFor(language, 'privacy')}>{translate('nav.privacy')}</a>
            <a href={pathFor(language, 'support')}>{translate('nav.support')}</a>
          </nav>
        </div>
        <p class="credits">{translate('footer.legal')}</p>
      </div>
    </footer>
  </body>
</html>

<style>
  .brand-mark {
    width: 36px;
    height: 36px;
  }
</style>
