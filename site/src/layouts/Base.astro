---
import { t, type UiLanguage } from '../i18n/ui';

type Props = {
  language: UiLanguage;
  title?: string;
  description?: string;
};

const { language, title, description } = Astro.props;
const translate = t(language);
const home = language === 'es' ? '/' : '/en/';
const mysteries = language === 'es' ? '/misterios/' : '/en/mysteries/';
const other = language === 'es' ? '/en/' : '/';
---

<!doctype html>
<html lang={language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ?? translate('site.title')}</title>
    <meta name="description" content={description ?? translate('site.description')} />
    <link
      rel="alternate"
      hreflang="es"
      href={new URL('/', Astro.site ?? Astro.url).href}
    />
    <link
      rel="alternate"
      hreflang="en"
      href={new URL('/en/', Astro.site ?? Astro.url).href}
    />
  </head>
  <body>
    <header>
      <a href={home} class="brand">{translate('site.title')}</a>
      <nav>
        <a href={mysteries}>{translate('nav.mysteries')}</a>
        <a href={other} class="lang">{language === 'es' ? 'English' : 'Español'}</a>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <style is:global>
      :root {
        --background: #fbf9f6;
        --surface: #ffffff;
        --text: #1a1714;
        --muted: #6b6259;
        --accent: #7a2e3b;
        --border: #e5ded4;
        color-scheme: light dark;
      }

      @media (prefers-color-scheme: dark) {
        :root {
          --background: #12100e;
          --surface: #1c1917;
          --text: #f2ede6;
          --muted: #a39b90;
          --accent: #c98b96;
          --border: #2c2724;
        }
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        background: var(--background);
        color: var(--text);
        font-family: ui-serif, Georgia, 'Times New Roman', serif;
        line-height: 1.6;
        font-size: 18px;
      }

      header {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 24px;
        padding: 24px 20px;
        max-width: 720px;
        margin: 0 auto;
      }

      nav {
        display: flex;
        gap: 20px;
      }

      a {
        color: inherit;
      }

      .brand {
        font-weight: 600;
        text-decoration: none;
      }

      main {
        max-width: 720px;
        margin: 0 auto;
        padding: 24px 20px 80px;
      }

      h1 {
        font-size: 2rem;
        line-height: 1.2;
        margin: 0 0 12px;
      }

      h2 {
        font-size: 1.3rem;
        margin: 40px 0 12px;
      }

      p.lead {
        color: var(--muted);
        margin-top: 0;
      }
    </style>
  </body>
</html>
