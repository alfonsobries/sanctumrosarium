---
import { t, type UiLanguage } from '../i18n/ui';
import { stores } from '../i18n/paths';

type Props = { language: UiLanguage; class?: string };

const { language, class: className = '' } = Astro.props;
const translate = t(language);
const apple = language === 'es' ? '/badges/app-store-es.svg' : '/badges/app-store-en.svg';
const play =
  language === 'es' ? '/badges/google-play-es.png' : '/badges/google-play-en.png';
---

<div
  class:list={['stores', className]}
  role="group"
  aria-label={translate('hero.stores')}
>
  <a href={stores.appStore}>
    <img
      class="badge-apple"
      src={apple}
      alt={translate('cta.appstore')}
      width="120"
      height="40"
      loading="lazy"
    />
  </a>
  <a href={stores.playStore}>
    <img
      class="badge-play"
      src={play}
      alt={translate('cta.play')}
      width="150"
      height="58"
      loading="lazy"
    />
  </a>
</div>

<style>
  .stores {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
  }

  .stores a {
    display: block;
    line-height: 0;
    border-radius: 6px;
  }

  .badge-apple {
    height: 42px;
    width: auto;
  }

  .badge-play {
    height: 62px;
    width: auto;
    margin-block: -10px;
  }
</style>
