---
import { findPrayer } from '@rosario/content';
import { mysteriesOfDay, mysteriesOfSet } from '@rosario/engine';

import { t, type UiLanguage } from '../i18n/ui';

type Props = { language: UiLanguage };

const { language } = Astro.props;
const translate = t(language);
const locale = language === 'es' ? 'es-MX' : 'en-US';
const ave = findPrayer('ave-maria', locale);
const today = mysteriesOfDay(new Date());
const first = mysteriesOfSet(today.set)[0];
const mysteryTitle = first?.text[language].title ?? '';
const lines = ave?.lines ?? [];
const responseFrom = ave?.responseFrom ?? 4;
const setLabel = {
  gaudiosa: translate('sets.gaudiosa'),
  luminosa: translate('sets.luminosa'),
  dolorosa: translate('sets.dolorosa'),
  gloriosa: translate('sets.gloriosa'),
}[today.set];
---

<div class="devices" aria-hidden="true">
  <div class="phone">
    <div class="device-screen">
      <span class="device-kicker">{translate('home.today')}</span>
      <p class="device-mystery">{mysteryTitle}</p>
      {
        lines.map((line, index) => (
          <p
            class:list={['prayer-line', index < responseFrom ? 'is-lead' : 'is-response']}
          >
            {line}
          </p>
        ))
      }
      <p class="bead">{translate('mock.ave')}</p>
    </div>
  </div>
  <div class="watch">
    <div class="device-screen">
      <span class="device-kicker">{setLabel}</span>
      <p class="device-mystery">{mysteryTitle}</p>
      <p class="prayer-line is-response" style="font-size: 2.4rem; line-height: 1;">
        {translate('mock.watchBead')}
      </p>
      <p class="bead">{translate('mock.ave')}</p>
    </div>
  </div>
</div>
