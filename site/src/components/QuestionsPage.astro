---
import Base from '../layouts/Base.astro';
import { questions } from '../i18n/questions';
import type { UiLanguage } from '../i18n/ui';

type Props = { language: UiLanguage };

const { language } = Astro.props;
const content = questions[language];
---

<Base
  language={language}
  current="questions"
  title={content.title}
  description={content.lead}
>
  <article class="wrap">
    <header class="page-head">
      <h1>{content.title}</h1>
      <p class="lead">{content.lead}</p>
      <nav class="jump" aria-label={content.title}>
        {
          content.sections.map((section) => (
            <a href={`#${section.id}`}>{section.title}</a>
          ))
        }
      </nav>
    </header>
    <div class="sections">
      {
        content.sections.map((section) => (
          <section class="qa" id={section.id} aria-labelledby={`${section.id}-title`}>
            <h2 id={`${section.id}-title`}>{section.title}</h2>
            {section.paragraphs.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
            {section.source ? <p class="source">{section.source}</p> : null}
          </section>
        ))
      }
    </div>
  </article>
</Base>

<style>
  .sections {
    max-width: var(--measure);
    display: grid;
    gap: var(--space-4);
    padding-bottom: var(--space-5);
  }

  .qa h2 {
    font-family: var(--font-serif);
    font-size: 1.45rem;
    margin: 0 0 var(--space-2);
  }

  .qa p {
    margin: 0 0 var(--space-2);
  }

  .source {
    color: var(--mute);
    font-size: 0.95rem;
  }

  .jump {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-2);
    margin-top: var(--space-2);
  }

  .jump a {
    color: var(--mute);
    font-size: 0.95rem;
  }
</style>
