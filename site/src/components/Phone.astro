---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/** An app screenshot in a phone frame drawn with CSS, so it stays sharp at any size. */
type Props = { src: ImageMetadata; alt: string; class?: string; eager?: boolean; sizes?: string };
const { src, alt, class: className, eager = false, sizes = '(max-width: 700px) 64vw, 248px' } = Astro.props;
---

<div class:list={['phone', className]}>
  <Image
    src={src}
    alt={alt}
    widths={[240, 360, 480, 640]}
    sizes={sizes}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : undefined}
  />
</div>

<style>
  .phone {
    position: relative;
    aspect-ratio: 1206 / 2622;
    padding: 2.4%;
    border-radius: 13% / 6%;
    background: linear-gradient(145deg, #2b2f3a, #0b0d12 60%);
    box-shadow:
      0 0 0 1px rgb(255 255 255 / 0.08) inset,
      var(--shadow);
  }

  .phone :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 11% / 5.1%;
    background: var(--surface);
  }
</style>
