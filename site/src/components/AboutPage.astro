---
import Base from '../layouts/Base.astro';
import { t, type UiKey, type UiLanguage } from '../i18n/ui';

type Props = { language: UiLanguage };

const { language } = Astro.props;
const translate = t(language);
const rules = [1, 2, 3, 4, 5, 6, 7, 8, 9].map((n) => ({
  title: `about.${n}.title` as UiKey,
  body: `about.${n}.body` as UiKey,
}));
---

<Base
  language={language}
  current="about"
  title={translate('about.title')}
  description={translate('about.lead')}
>
  <div class="wrap">
    <header class="page-head">
      <h1>{translate('about.title')}</h1>
      <p class="lead">{translate('about.lead')}</p>
    </header>
  </div>

  <div class="wrap">
    <ol class="rules">
      {
        rules.map((rule) => (
          <li>
            <h2>{translate(rule.title)}</h2>
            <p>{translate(rule.body)}</p>
          </li>
        ))
      }
    </ol>
  </div>
</Base>

<style>
  .rules {
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: 52rem;
    border-top: 1px solid var(--line);
  }

  .rules li {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
    gap: var(--space-2) var(--space-5);
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--line);
  }

  .rules h2 {
    font-size: 1.5rem;
  }

  .rules p {
    color: var(--ink-2);
    font-size: 1.1rem;
  }

  @media (max-width: 700px) {
    .rules li {
      grid-template-columns: 1fr;
      gap: var(--space-1);
    }
  }
</style>
