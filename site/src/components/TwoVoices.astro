---
import { findPrayer, type Locale } from '@rosario/content';

import { t, type UiLanguage } from '../i18n/ui';

type Props = { language: UiLanguage };

const { language } = Astro.props;
const translate = t(language);

const options: { id: string; locale: Locale; label: string; lang: string }[] = [
  { id: 'es', locale: 'es-MX', label: translate('voices.lang.es'), lang: 'es' },
  { id: 'la', locale: 'la', label: translate('voices.lang.la'), lang: 'la' },
  { id: 'en', locale: 'en-US', label: translate('voices.lang.en'), lang: 'en' },
];
const ordered = language === 'es' ? options : [...options].reverse();
const prayers = ordered.map((option) => ({
  ...option,
  prayer: findPrayer('ave-maria', option.locale),
}));
---

<section class="voices section" aria-labelledby="voices-title">
  <div class="wrap grid">
    <div class="copy">
      <span class="kicker">{translate('voices.kicker')}</span>
      <h2 id="voices-title">{translate('voices.title')}</h2>
      <p class="lead">{translate('voices.body')}</p>
      <fieldset class="tabs">
        <legend class="sr-only">{translate('voices.language')}</legend>
        {
          prayers.map((option, index) => (
            <>
              <input
                type="radio"
                name="voices-lang"
                id={`voices-${option.id}`}
                value={option.id}
                checked={index === 0}
              />
              <label for={`voices-${option.id}`} lang={option.lang}>
                {option.label}
              </label>
            </>
          ))
        }
      </fieldset>
    </div>

    <div class="stage">
      {
        prayers.map((option) => {
          const lines = option.prayer?.lines ?? [];
          const from = option.prayer?.responseFrom ?? lines.length;
          return (
            <div class="panel" data-lang={option.id} lang={option.lang}>
              <p class="prayer">
                <span class="part">
                  <span class="voice voice-guide">{translate('voices.guide')}</span>
                  {lines.slice(0, from).map((line) => (
                    <span class="line is-lead">{line}</span>
                  ))}
                </span>
                <span class="part">
                  <span class="voice voice-you">{translate('voices.you')}</span>
                  {lines.slice(from).map((line) => (
                    <span class="line is-response">{line}</span>
                  ))}
                </span>
              </p>
            </div>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: var(--space-5);
    align-items: start;
  }

  .copy .lead {
    margin-top: var(--space-2);
  }

  .copy .tabs {
    margin: var(--space-4) 0 0;
    border-color: var(--line);
  }

  fieldset.tabs {
    padding: 3px;
  }

  .stage {
    position: relative;
    display: grid;
  }

  .panel {
    grid-area: 1 / 1;
    visibility: hidden;
    opacity: 0;
    transition: opacity 200ms ease;
  }

  .part {
    display: block;
    position: relative;
    padding-left: 5.5rem;
  }

  .part + .part {
    margin-top: 0.6em;
  }

  .voice {
    position: absolute;
    left: 0;
    top: 0.3em;
    width: 4.5rem;
    text-align: right;
    font-family: var(--font-caps);
    font-size: 0.85rem;
    letter-spacing: 0.06em;
    color: var(--rose);
    line-height: 1;
  }

  .voice-guide {
    color: var(--mute);
  }

  .prayer {
    font-size: clamp(1.4rem, 2.4vw, 1.9rem);
    line-height: 1.35;
  }

  .voices:has(#voices-es:checked) .panel[data-lang='es'],
  .voices:has(#voices-la:checked) .panel[data-lang='la'],
  .voices:has(#voices-en:checked) .panel[data-lang='en'] {
    visibility: visible;
    opacity: 1;
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }

    .part {
      padding-left: 0;
    }

    .voice {
      position: static;
      display: block;
      width: auto;
      text-align: left;
      margin-bottom: 0.3em;
    }
  }
</style>
