---
import { findPrayer } from '@rosario/content';
import type { UiLanguage } from '../i18n/ui';

type Props = { language: UiLanguage };

const { language } = Astro.props;
const latin = findPrayer('ave-maria', 'la');
const own = findPrayer('ave-maria', language === 'es' ? 'es-MX' : 'en-US');
const days =
  language === 'es'
    ? ['L', 'M', 'X', 'J', 'V', 'S', 'D']
    : ['M', 'T', 'W', 'T', 'F', 'S', 'S'];
---

<div class="strip" aria-hidden="true">
  <div class="phone small">
    <div class="device-screen">
      <span class="device-kicker">LA / {language.toUpperCase()}</span>
      <p class="prayer-line is-lead">{latin?.lines[0]}</p>
      <p class="prayer-line is-response">{own?.lines[0]}</p>
      <p class="prayer-line is-lead">{latin?.lines[4]}</p>
      <p class="prayer-line is-response">{own?.lines[4]}</p>
    </div>
  </div>
  <div class="phone small">
    <div class="device-screen">
      <span class="device-kicker">{language === 'es' ? 'Agosto' : 'August'}</span>
      <div class="cal">
        {days.map((day) => <span class="cal-h">{day}</span>)}
        {
          Array.from({ length: 31 }, (_, index) => (
            <span class:list={['cal-d', index % 3 === 0 ? 'is-on' : undefined]}>
              {index + 1}
            </span>
          ))
        }
      </div>
    </div>
  </div>
  <div class="phone small">
    <div class="device-screen">
      <span class="device-kicker">{language === 'es' ? 'Ajustes' : 'Settings'}</span>
      <p class="prayer-line is-response">
        {language === 'es' ? 'Forma mexicana' : 'Roman form'}
      </p>
      <p class="prayer-line is-lead">
        {language === 'es' ? 'Oración de Fátima' : 'Fatima prayer'}
      </p>
      <p class="prayer-line is-lead">{language === 'es' ? 'Letanías' : 'Litany'}</p>
      <p class="prayer-line is-response">
        {language === 'es' ? 'Audio: guía' : 'Audio: guide'}
      </p>
    </div>
  </div>
</div>

<style>
  .strip {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    margin-top: 40px;
  }

  .phone.small {
    min-height: 280px;
  }

  .cal {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 6px;
    font-size: 0.72rem;
    color: var(--mute);
  }

  .cal-h {
    text-align: center;
    font-size: 0.65rem;
    letter-spacing: 0.04em;
  }

  .cal-d {
    text-align: center;
    padding: 4px 0;
    border-radius: 999px;
  }

  .cal-d.is-on {
    background: var(--mark);
    color: var(--bg);
  }

  @media (max-width: 800px) {
    .strip {
      grid-template-columns: 1fr;
    }
  }
</style>
