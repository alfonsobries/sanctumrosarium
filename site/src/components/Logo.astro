---
import mark from '../assets/logo.svg?raw';

type Props = {
  class?: string;
  /** Accessible name. Omit when the mark is decorative next to the wordmark. */
  label?: string;
};

const { class: className = '', label } = Astro.props;
---

<span
  class:list={['logo', className]}
  set:html={mark}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
/>

<style>
  .logo {
    display: block;
    color: var(--rose);
    line-height: 0;
  }

  .logo :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
