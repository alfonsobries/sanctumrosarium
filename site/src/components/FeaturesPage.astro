---
import Base from '../layouts/Base.astro';
import { t, type UiLanguage } from '../i18n/ui';
import { catalog } from '../i18n/features';

type Props = { language: UiLanguage };

const { language } = Astro.props;
const translate = t(language);
const groups = catalog[language];
---

<Base
  language={language}
  current="features"
  title={translate('features.title')}
  description={translate('features.lead')}
>
  <div class="wrap">
    <header class="page-head">
      <h1>{translate('features.title')}</h1>
      <p class="lead">{translate('features.lead')}</p>
    </header>
  </div>

  <div class="wrap layout">
    <nav class="index" aria-label={translate('features.index')}>
      <span class="kicker">{translate('features.index')}</span>
      <ol>
        {
          groups.map((group) => (
            <li>
              <a href={`#${group.id}`}>{group.title}</a>
            </li>
          ))
        }
      </ol>
    </nav>

    <div class="groups">
      {
        groups.map((group) => (
          <section class="group" id={group.id} aria-labelledby={`${group.id}-title`}>
            <div class="group-head">
              <h2 id={`${group.id}-title`}>{group.title}</h2>
              <p class="lead">{group.lead}</p>
            </div>
            <dl class="items">
              {group.items.map((item) => (
                <div class="item">
                  <dt>{item.title}</dt>
                  <dd>{item.body}</dd>
                </div>
              ))}
            </dl>
          </section>
        ))
      }
    </div>
  </div>
</Base>

<style>
  .layout {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
    gap: var(--space-5);
    align-items: start;
  }

  .index {
    position: sticky;
    top: 92px;
  }

  .index ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 6px;
  }

  .index a {
    color: var(--mute);
    text-decoration: none;
    font-size: 1rem;
  }

  .index a:hover {
    color: var(--ink);
  }

  .group {
    padding-block: var(--space-4) var(--space-5);
    border-top: 1px solid var(--line);
    scroll-margin-top: 90px;
  }

  .group:first-child {
    padding-top: 0;
    border-top: 0;
  }

  .group-head .lead {
    margin-top: var(--space-1);
    color: var(--mute);
  }

  .items {
    margin: var(--space-4) 0 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3) var(--space-4);
  }

  .item dt {
    font-family: var(--font-serif);
    font-size: 1.3rem;
    line-height: 1.2;
  }

  .item dd {
    margin: 0.35rem 0 0;
    color: var(--ink-2);
    font-size: 1.05rem;
    max-width: 30rem;
  }

  @media (max-width: 900px) {
    .layout {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }

    .index {
      position: static;
    }

    .index ol {
      display: flex;
      flex-wrap: wrap;
      gap: 6px 18px;
    }

    .items {
      grid-template-columns: 1fr;
    }
  }
</style>
