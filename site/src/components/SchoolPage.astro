---
import { schoolPages } from '@rosario/content';

import Base from '../layouts/Base.astro';
import { t, type UiLanguage } from '../i18n/ui';

type Props = { language: UiLanguage };

const { language } = Astro.props;
const translate = t(language);

const kindLabel = (kind: string | undefined): string | undefined => {
  if (kind === 'magisterium' || kind === 'liturgy' || kind === 'tradition') {
    return translate(`school.kind.${kind}`);
  }
  return undefined;
};
---

<Base
  language={language}
  current="school"
  title={translate('school.title')}
  description={translate('school.lead')}
>
  <div class="wrap">
    <header class="page-head">
      <h1>{translate('school.title')}</h1>
      <p class="lead">{translate('school.lead')}</p>
      <nav class="jump" aria-label={translate('school.title')}>
        {
          schoolPages.map((page) => (
            <a href={`#${page.id}`}>{page.text[language].title}</a>
          ))
        }
      </nav>
    </header>
  </div>

  <div class="wrap">
    {
      schoolPages.map((page) => {
        const text = page.text[language];
        return (
          <section class="school-page" id={page.id} aria-labelledby={`${page.id}-title`}>
            <h2 id={`${page.id}-title`}>{text.title}</h2>
            <p class="lead">{text.lead}</p>
            {text.blocks.map((block) => (
              <div class="block">
                <p>{block.text}</p>
                {block.cite ? (
                  <p class="cite">
                    {kindLabel(block.kind) ? (
                      <span class="kind">{kindLabel(block.kind)}</span>
                    ) : null}
                    {block.cite}
                  </p>
                ) : null}
              </div>
            ))}
            <p class="mute source">
              {translate('school.source')}{' '}
              {page.source[language].url ? (
                <a href={page.source[language].url}>{page.source[language].name}</a>
              ) : (
                page.source[language].name
              )}
            </p>
          </section>
        );
      })
    }
  </div>
</Base>

<style>
  .school-page {
    margin-top: var(--space-7);
    max-width: 42rem;
  }
  .school-page > .lead {
    color: var(--muted);
    margin-top: var(--space-2);
  }
  .block {
    margin-top: var(--space-4);
  }
  .block p {
    line-height: 1.7;
  }
  .cite {
    margin-top: var(--space-1);
    font-size: var(--text-sm);
    color: var(--muted);
  }
  .kind {
    font-variant: small-caps;
    letter-spacing: 0.04em;
    margin-right: 0.5em;
  }
  .source {
    margin-top: var(--space-4);
    font-size: var(--text-sm);
  }
  .jump {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-3);
    margin-top: var(--space-3);
  }
</style>
