---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/** An Apple Watch screenshot in a case drawn with CSS, crown included. */
type Props = { src: ImageMetadata; alt: string; class?: string };
const { src, alt, class: className } = Astro.props;
---

<div class:list={['watch', className]}>
  <div class="case">
    <Image src={src} alt={alt} widths={[240, 360]} sizes="220px" loading="lazy" />
  </div>
  <span class="crown" aria-hidden="true"></span>
</div>

<style>
  .watch {
    position: relative;
    width: 100%;
    max-width: 15rem;
    margin-inline: auto;
  }

  .case {
    aspect-ratio: 416 / 496;
    padding: 9%;
    border-radius: 30% / 25%;
    background: linear-gradient(145deg, #2b2f3a, #0b0d12 60%);
    box-shadow:
      0 0 0 1px rgb(255 255 255 / 0.08) inset,
      var(--shadow);
  }

  .case :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 22% / 18%;
    background: #000;
  }

  .crown {
    position: absolute;
    right: -4%;
    top: 26%;
    width: 5%;
    height: 16%;
    border-radius: 3px;
    background: linear-gradient(90deg, #1c1f27, #3a3f4c);
  }
</style>
