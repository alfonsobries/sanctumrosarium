---
import type { Mystery, MysterySetId } from '@rosario/content';

import { t, type UiLanguage } from '../i18n/ui';

type Props = {
  language: UiLanguage;
  set: MysterySetId;
  mysteries: readonly Mystery[];
};

const { language, set, mysteries } = Astro.props;
const translate = t(language);
const setKey = `sets.${set}` as const;
---

<section>
  <!--
    Built statically: this is the day the site was built, not the day it is read. Until the page
    resolves the date in the browser, it says so instead of announcing the wrong mystery.
  -->
  <h2>{translate('home.today')}: {translate(setKey)}</h2>
  <ol>
    {
      mysteries.map((mystery) => (
        <li>
          {mystery.text[language].title} <span class="ref">{mystery.scriptureRef}</span>
        </li>
      ))
    }
  </ol>
</section>

<style>
  ol {
    padding-left: 1.2em;
  }

  li {
    margin-bottom: 6px;
  }

  .ref {
    color: var(--muted);
    font-size: 0.9em;
  }
</style>
