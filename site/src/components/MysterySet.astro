---
import type { Mystery, MysterySetId } from '@rosario/content';

import { t, type UiLanguage } from '../i18n/ui';

type Props = {
  language: UiLanguage;
  set: MysterySetId;
  mysteries: readonly Mystery[];
};

const { language, set, mysteries } = Astro.props;
const translate = t(language);
const setKey = `sets.${set}` as const;
---

<section>
  <h2>{translate(setKey)}</h2>

  {
    mysteries.map((mystery) => (
      <article>
        <h3>
          {mystery.order}. {mystery.text[language].title}
        </h3>
        <p class="meta">
          <span class="ref">{mystery.scriptureRef}</span>
          <span>
            {translate('mysteries.fruit')}: {mystery.text[language].fruit}
          </span>
        </p>
        {mystery.text[language].meditation ? (
          <p>{mystery.text[language].meditation}</p>
        ) : null}
        {mystery.text.la.clause ? (
          <p class="clause">
            {translate('mysteries.clause')}: <em>{mystery.text.la.clause}</em>
          </p>
        ) : null}
      </article>
    ))
  }
</section>

<style>
  article {
    padding: 16px 0;
    border-bottom: 1px solid var(--border);
  }

  h3 {
    font-size: 1.05rem;
    margin: 0 0 4px;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    color: var(--muted);
    font-size: 0.9rem;
    margin: 0 0 8px;
  }

  p {
    margin: 0 0 8px;
  }

  .clause {
    color: var(--muted);
    font-size: 0.95rem;
  }
</style>
