---
import type { PrayerText } from '@rosario/content';

/**
 * A prayer laid out line by line. When it is prayed in two voices, the guide's lines are
 * muted and the response is full ink, the same way the app shows it.
 */
type Props = {
  prayer: PrayerText;
  lang: string;
  class?: string;
};

const { prayer, lang, class: className = '' } = Astro.props;
const from = prayer.responseFrom;
---

<p class:list={['prayer', 'lines', className]} lang={lang}>
  {
    prayer.lines.map((line, index) => (
      <span
        class:list={[
          'line',
          from === undefined ? undefined : index < from ? 'is-lead' : 'is-response',
        ]}
      >
        {line}
      </span>
    ))
  }
</p>

<style>
  .lines {
    font-size: 1.3rem;
    line-height: 1.4;
  }

  .lines .is-response {
    display: block;
  }

  .lines .is-lead + .is-response {
    margin-top: 0.4em;
  }
</style>
