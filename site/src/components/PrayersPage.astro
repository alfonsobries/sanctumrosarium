---
import { alternatesOf, prayerPageIds, prayerRoute, route, type Language } from '../i18n/routes';
import { t, type UiKey } from '../i18n/ui';
import Base from '../layouts/Base.astro';
import { hasPrayerPage, prayerCategory, prayerLines, prayerName } from '../lib/content';
import { itemList } from '../lib/schema';

type Props = { language: Language };
const { language } = Astro.props;
const translate = t(language);
const prayers = prayerPageIds.filter((id) => hasPrayerPage(id, language));
---

<Base
  language={language}
  title={translate('prayers.title')}
  description={translate('prayers.description')}
  alternates={alternatesOf('prayers')}
  trail={[{ name: translate('breadcrumb.home'), url: route('home', language) }]}
  og="prayers"
  schema={[
    itemList(
      translate('prayers.title'),
      prayers.map((id) => ({ name: prayerName(id, language), url: prayerRoute(id, language) })),
    ),
  ]}
>
  <header class="wrap page-head">
    <span class="kicker">{translate('prayers.kicker')}</span>
    <h1>{translate('prayers.title')}</h1>
    <p class="lead" data-speakable>{translate('prayers.lead')}</p>
  </header>

  <ol class="wrap list">
    {
      prayers.map((id, index) => {
        const opening = id === 'litany-of-loreto' ? null : prayerLines(id, language).lines[0];
        return (
          <li>
            <a href={prayerRoute(id, language)}>
              <span class="index">{String(index + 1).padStart(2, '0')}</span>
              <span class="body">
                <span class="name">{prayerName(id, language)}</span>
                {opening !== null && opening !== undefined && <span class="first">{opening}</span>}
              </span>
              <span class="category">{translate(`category.${prayerCategory(id)}` as UiKey)}</span>
            </a>
          </li>
        );
      })
    }
  </ol>

  <section class="wrap promises">
    <a class="card promises-card" href={route('promises', language)}>
      <span class="kicker">{translate('promises.kicker')}</span>
      <span class="title">{translate('promises.title')}</span>
    </a>
  </section>
</Base>

<style>
  .list {
    margin-block: 0;
    margin-inline: auto;
    padding-left: 0;
    list-style: none;
    display: grid;
    border-top: 1px solid var(--line);
  }

  .list a {
    display: grid;
    grid-template-columns: 3rem 1fr auto;
    gap: var(--space-2);
    align-items: baseline;
    padding: 1.3rem 0;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
    transition: background 0.2s;
  }

  .list a:hover .name {
    color: var(--accent);
  }

  .index {
    font-size: var(--step--1);
    color: var(--faint);
    font-variant-numeric: tabular-nums;
  }

  .body {
    display: grid;
    gap: 0.25rem;
  }

  .name {
    font-family: var(--serif);
    font-size: var(--step-2);
    transition: color 0.2s;
  }

  .first {
    color: var(--mute);
    font-family: var(--serif);
    font-style: italic;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 40rem;
  }

  .category {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--faint);
  }

  .promises {
    padding-top: var(--space-5);
  }

  .promises-card {
    display: grid;
    gap: 0.5rem;
    padding: var(--space-4);
    text-decoration: none;
    background: linear-gradient(160deg, var(--glow), var(--surface) 55%);
  }

  .promises-card .title {
    font-family: var(--serif);
    font-size: var(--step-3);
  }

  @media (max-width: 700px) {
    .list a {
      grid-template-columns: 2.2rem 1fr;
    }

    .category {
      display: none;
    }

    .first {
      white-space: normal;
    }
  }
</style>
