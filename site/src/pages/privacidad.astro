---
import Base from '../layouts/Base.astro';
import { t } from '../i18n/ui';

const language = 'es' as const;
const translate = t(language);
---

<Base language={language} current="privacy" title={translate('privacy.title')}>
  <article class="page-head wrap prose">
    <h1>{translate('privacy.title')}</h1>
    <p class="lead">{translate('privacy.lead')}</p>
    <p>{translate('privacy.p1')}</p>
    <p>{translate('privacy.p2')}</p>
    <p>{translate('privacy.p3')}</p>
    <p>{translate('privacy.p4')}</p>
  </article>
</Base>
