---
import { mysteries } from '@rosario/content';

import Base from '../layouts/Base.astro';
import MysterySet from '../components/MysterySet.astro';
import { t } from '../i18n/ui';

const translate = t('es');
const sets = ['gaudiosa', 'luminosa', 'dolorosa', 'gloriosa'] as const;
---

<Base
  language="es"
  title={`${translate('mysteries.title')} - ${translate('site.title')}`}
>
  <h1>{translate('mysteries.title')}</h1>
  <p class="lead">{translate('mysteries.lead')}</p>

  {
    sets.map((set) => (
      <MysterySet
        language="es"
        set={set}
        mysteries={mysteries.filter((mystery) => mystery.set === set)}
      />
    ))
  }
</Base>
