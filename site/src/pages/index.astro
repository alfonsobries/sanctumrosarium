---
import { mysteriesOfDay, mysteriesOfSet } from '@rosario/engine';

import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import StoreBadges from '../components/StoreBadges.astro';
import DevicePair from '../components/DevicePair.astro';
import ScreenStrip from '../components/ScreenStrip.astro';
import Today from '../components/Today.astro';
import { t } from '../i18n/ui';
import { pathFor } from '../i18n/paths';

const language = 'es' as const;
const translate = t(language);
const today = mysteriesOfDay(new Date());
const mysteries = mysteriesOfSet(today.set);
---

<Base language={language} current="home">
  <section class="hero wrap">
    <div class="mark">
      <Logo />
    </div>
    <h1>{translate('site.title')}</h1>
    <p class="lead">{translate('hero.lead')}</p>
    <p class="sub">{translate('hero.sub')}</p>
    <StoreBadges language={language} />
    <DevicePair language={language} />
  </section>

  <section class="wrap promises">
    <article class="promise">
      <h2>{translate('promise.1.title')}</h2>
      <p>{translate('promise.1.body')}</p>
    </article>
    <article class="promise">
      <h2>{translate('promise.2.title')}</h2>
      <p>{translate('promise.2.body')}</p>
    </article>
    <article class="promise">
      <h2>{translate('promise.3.title')}</h2>
      <p>{translate('promise.3.body')}</p>
    </article>
  </section>

  <section class="wrap" style="padding-bottom: 24px;">
    <ScreenStrip language={language} />
  </section>

  <section class="band">
    <div class="wrap band-grid">
      <div>
        <span class="kicker">{translate('band.audio.kicker')}</span>
        <h2>{translate('band.audio.title')}</h2>
        <p class="lead">{translate('band.audio.body')}</p>
      </div>
      <div>
        <span class="kicker">{translate('band.watch.kicker')}</span>
        <h2>{translate('band.watch.title')}</h2>
        <p class="lead">{translate('band.watch.body')}</p>
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap band-grid">
      <div>
        <span class="kicker">{translate('band.latin.kicker')}</span>
        <h2>{translate('band.latin.title')}</h2>
        <p class="lead">{translate('band.latin.body')}</p>
      </div>
      <div>
        <span class="kicker">{translate('band.rule.kicker')}</span>
        <h2>{translate('band.rule.title')}</h2>
        <p class="lead">{translate('band.rule.body')}</p>
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <Today language={language} set={today.set} mysteries={mysteries} />
    </div>
  </section>

  <section class="band">
    <div class="wrap prose">
      <h2>{translate('home.more')}</h2>
      <p class="lead">{translate('home.more.body')}</p>
      <p>
        <a href={pathFor(language, 'features')}>{translate('home.more.cta')}</a>
      </p>
    </div>
  </section>
</Base>
