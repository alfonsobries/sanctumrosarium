---
import Base from '../layouts/Base.astro';
import { t } from '../i18n/ui';

const language = 'es' as const;
const translate = t(language);
---

<Base language={language} current="how" title={translate('how.title')}>
  <article class="page-head wrap prose">
    <h1>{translate('how.title')}</h1>
    <p class="lead">{translate('how.lead')}</p>
    <p>{translate('how.p1')}</p>
    <p>{translate('how.p2')}</p>
    <p>{translate('how.p3')}</p>
    <p>{translate('how.p4')}</p>
    <p class="legal">{translate('how.source')}</p>
  </article>
</Base>
