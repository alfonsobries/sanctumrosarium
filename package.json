{
  "name": "sanctamaria",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "app": "pnpm --filter app start",
    "test": "pnpm --filter './packages/*' --filter @sanctamaria/content test",
    "typecheck": "pnpm -r typecheck",
    "audio:generate": "tsx scripts/generate-audio.mts",
    "icons:generate": "tsx scripts/generate-icons.mts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "watch:content": "tsx scripts/build-watch-content.mts",
    "play": "bash scripts/play.sh",
    "ios:build": "bash scripts/device-build.sh ios",
    "ios:install": "bash scripts/device-install.sh ios",
    "android:build": "bash scripts/device-build.sh android",
    "android:install": "bash scripts/device-install.sh android",
    "ios:preview": "bash scripts/device-build.sh ios preview && bash scripts/device-install.sh ios",
    "ios:release": "bash scripts/release.sh ios all",
    "ios:release:build": "bash scripts/release.sh ios build",
    "ios:release:submit": "bash scripts/release.sh ios submit",
    "android:release": "bash scripts/release.sh android all",
    "android:release:build": "bash scripts/release.sh android build",
    "android:release:submit": "bash scripts/release.sh android submit",
    "update:preview": "cd app && npx eas-cli@latest update --channel preview --auto",
    "update:production": "cd app && npx eas-cli@latest update --channel production --auto"
  },
  "devDependencies": {
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15"
  }
}
