{
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "app": "pnpm --filter app start",
    "app:ios": "pnpm --filter app ios",
    "app:android": "pnpm --filter app android",
    "app:check": "pnpm --filter app check",
    "app:test": "pnpm --filter app test",
    "ios:build": "bash scripts/device-build.sh ios",
    "ios:install": "bash scripts/device-install.sh ios",
    "ios:release": "bash scripts/release.sh ios all",
    "ios:release:build": "bash scripts/release.sh ios build",
    "ios:release:submit": "bash scripts/release.sh ios submit",
    "android:build": "bash scripts/device-build.sh android",
    "android:install": "bash scripts/device-install.sh android",
    "android:release": "bash scripts/release.sh android all",
    "android:release:build": "bash scripts/release.sh android build",
    "android:release:submit": "bash scripts/release.sh android submit",
    "icons:generate": "node scripts/generate-app-icons.mjs",
    "dark": "bash scripts/theme.sh dark",
    "light": "bash scripts/theme.sh light",
    "site": "pnpm --filter site dev",
    "site:build": "pnpm --filter site build",
    "site:check": "pnpm --filter site check",
    "packages:test": "pnpm -r --filter \"./packages/*\" test",
    "packages:typecheck": "pnpm -r --filter \"./packages/*\" typecheck",
    "test": "pnpm packages:test && pnpm app:test",
    "typecheck": "pnpm packages:typecheck && pnpm --filter app typecheck && pnpm --filter site check",
    "lint": "pnpm --filter app lint:check && prettier --check .",
    "format": "prettier --write .",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "format:md": "prettier --write \"**/*.md\"",
    "postinstall": "aikit update",
    "audio:generate": "tsx scripts/generate-rosary-audio.ts",
    "store:screenshots": "bash scripts/store-screenshots.sh"
  },
  "devDependencies": {
    "@alfonsobries/aikit": "^0.10.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "sharp": "^0.35.3",
    "tsx": "^4.23.12"
  }
}
